# All optional. Defaults run fully offline with extractive answers.
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic            # or openai (any OpenAI-compatible server, e.g. Ollama)
# LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=
# GENERATOR=auto                    # auto | extractive | llm
# EMBEDDER=tfidf                    # or st (needs sentence-transformers)
# RETRIEVAL=hybrid                  # bm25 | vector | hybrid
# CHUNK_STRATEGY=section            # section | window
# ABSTAIN_THRESHOLD=0.35
